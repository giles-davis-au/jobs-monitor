<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gilesdavis.jobsmonitor</string>

    <!-- Runs as a LaunchDaemon (system domain), not a LaunchAgent, so the
         schedule doesn't depend on the GUI session being "active". A
         LaunchAgent's StartInterval spawn was observed getting stuck as
         "pending spawn, domain in on-demand-only mode" — logged exactly on
         schedule but never actually dispatched — while the Mac was awake
         the whole time (no sleep/wake events), seemingly because the GUI
         session wasn't considered active enough at that moment. Daemons
         aren't subject to that gating. UserName keeps it running as this
         user (not root) so file/permission behaviour is unchanged. -->
    <key>UserName</key>
    <string>gilesdavis</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/gilesdavis/Documents/Davis/coding/projects/jobs-monitor/.venv/bin/python</string>
        <string>/Users/gilesdavis/Documents/Davis/coding/projects/jobs-monitor/run.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/gilesdavis/Documents/Davis/coding/projects/jobs-monitor</string>

    <!-- Every 3 hours, counted from whenever this job is (re)installed —
         not anchored to fixed clock times. launchd will also catch up a
         missed run shortly after the Mac wakes/logs back in, which plain
         cron does not do reliably. -->
    <key>StartInterval</key>
    <integer>10800</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/gilesdavis/Documents/Davis/coding/projects/jobs-monitor/launchd/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gilesdavis/Documents/Davis/coding/projects/jobs-monitor/launchd/stderr.log</string>
</dict>
</plist>
