# Copy to .env and fill in (never commit .env — it's git-ignored)

# Sign up at https://resend.com (free tier), create an API key at
# https://resend.com/api-keys
RESEND_API_KEY=

# Resend's shared sandbox sender works out of the box with no domain setup,
# but can only send to the account's own verified email — fine for this
# personal tool. Only override this once/if you verify a custom domain.
RESEND_FROM=onboarding@resend.dev

NOTIFY_EMAIL_TO=gilesbdavis@gmail.com

# Optional — new matches are also appended to a Google Sheet if both of
# these are set (omit either to leave GSheet logging disabled). See README
# for the Apps Script source + deployment steps (no Google Cloud project,
# no service account — just a small script bound to the sheet itself).
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
